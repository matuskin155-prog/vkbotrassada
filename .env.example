# Скопируй этот файл в .env и заполни

# Ключ доступа сообщества (Управление → Работа с API → Ключи доступа)
VK_GROUP_TOKEN=
# ID сообщества, только цифры (без минуса)
VK_GROUP_ID=

# Ключ для чтения альбомов и ответов в комментариях: сервисный ключ приложения ВК
# или ключ пользователя-админа группы. Можно оставить пустым — тогда бот
# не увидит альбомы и не будет отвечать в комментариях.
VK_READ_TOKEN=

# ID альбомов с заказами через запятую (из ссылки vk.com/album-ГРУППА_АЛЬБОМ).
# Пусто — берутся все альбомы группы.
ORDER_ALBUM_IDS=

# ID страниц админов через запятую — сюда бот шлёт уведомления о заказах и вызовах менеджера.
# Админы должны сами написать в сообщения группы хотя бы раз, иначе бот не сможет им писать.
ADMIN_IDS=

# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 — дешевле и быстрее, claude-sonnet-5-5 — умнее
CLAUDE_MODEL=claude-haiku-5-5

SHOP_NAME=Рассада у дома
# На сколько часов бот замолкает в диалоге после вызова менеджера или ручного ответа
PAUSE_HOURS=12
# Отвечать ли в комментариях под фото (1 — да, 0 — нет)
REPLY_IN_COMMENTS=1
# Как часто обновлять каталог, в минутах
CATALOG_REFRESH_MIN=30
